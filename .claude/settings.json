{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build:plugin)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/rebuild-plugin.mjs" }
        ]
      }
    ]
  }
}
